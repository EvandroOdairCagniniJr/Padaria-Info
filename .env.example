# Copie para .env e ajuste. O servidor (npm start) lê este arquivo.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sua-senha-do-mysql
MYSQL_DATABASE=padaria_info
# MySQL na nuvem (Aiven etc.): MYSQL_SSL=true e o certificado CA (PEM) em MYSQL_SSL_CA.
MYSQL_SSL=false
MYSQL_SSL_CA=
# Chave para assinar os logins — qualquer texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-aleatorio
PORT=3000

# E-mail para o "Esqueci minha senha" (envio do código de acesso).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu e-mail e SMTP_PASS=uma
# "senha de app" (myaccount.google.com/apppasswords — precisa da verificação em 2 etapas).
# Sem isso, o código aparece só no terminal do servidor.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente mostrado no e-mail (padrão: SMTP_USER)
SMTP_FROM=

# Nome que aparece no comprovante enviado ao cliente
VITE_NOME_PADARIA=Padaria
# Opcionais, aparecem no cabeçalho do comprovante
VITE_ENDERECO_PADARIA=
VITE_CNPJ_PADARIA=
VITE_TELEFONE_PADARIA=
